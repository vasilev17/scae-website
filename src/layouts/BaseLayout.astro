---
import '@/styles/global.css';

import plateiaBold from '@/assets/generated/plateia-bold.woff2?url';
import {
  defaultLocale,
  getDictionary,
  locales,
  localeUrl,
  type Locale,
} from '@/i18n';

type Props = {
  locale: Locale;
  title: string;
  description?: string;
  // Path without locale prefix
  path?: string;
};

const { locale, title, path = '/' } = Astro.props;
const t = getDictionary(locale);
const description = Astro.props.description ?? t.site.description;

const canonical = new URL(localeUrl(locale, path), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href={plateiaBold}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate}
          href={new URL(localeUrl(alternate, path), Astro.site ?? Astro.url)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeUrl(defaultLocale, path), Astro.site ?? Astro.url)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <script>
      import { getSmoothScroll } from '@/lib/smooth-scroll';

      getSmoothScroll();
    </script>
  </body>
</html>
