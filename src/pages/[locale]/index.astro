---
import gateMetal from '@/assets/generated/gate-metal.webp';
import scaeLogo from '@/assets/generated/scae-logo.webp';
import contactDot from '@/assets/icons/contact-dot.svg?url';
import menuGrid from '@/assets/icons/menu-grid.svg?url';
import { LandingHero } from '@/components/ui/LandingHero';
import { getDictionary, localeStaticPaths, resolveLocale } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = localeStaticPaths;

const locale = resolveLocale(Astro.params.locale);
const t = getDictionary(locale);

// Anchors are placeholders until the sections they name exist.
const menuItems = [
  { id: 'about', label: t.menu.items.about, href: '#about' },
  { id: 'projects', label: t.menu.items.projects, href: '#projects' },
  { id: 'team', label: t.menu.items.team, href: '#team' },
  { id: 'events', label: t.menu.items.events, href: '#events' },
  { id: 'join', label: t.menu.items.join, href: '#join' },
  { id: 'contact', label: t.menu.items.contact, href: '#contact' },
];
---

<BaseLayout locale={locale} title={t.site.name}>
  <LandingHero
    client:load
    metalSrc={gateMetal.src}
    logoSrc={scaeLogo.src}
    contactIconSrc={contactDot}
    menuIconSrc={menuGrid}
    label={t.home.heading}
    headline={t.home.headline}
    subtitle={t.home.subtitle}
    seeMore={t.home.seeMore}
    exhibitName={t.home.commodore}
    nav={{
      label: t.nav.label,
      brand: t.nav.brand,
      contact: t.nav.contact,
      menu: t.nav.menu,
    }}
    menu={{ label: t.menu.label, close: t.menu.close, items: menuItems }}
  />
  <section
    id="after-hero"
    class="bg-background flex min-h-dvh w-full items-center justify-center px-6 text-center"
  >
    <h2 class="text-muted text-2xl sm:text-4xl">{t.home.outro}</h2>
  </section>
</BaseLayout>
