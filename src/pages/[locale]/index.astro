---
import ansysLogo from '@/assets/images/partners/ANSYS.png';
import dassaultLogo from '@/assets/images/partners/DASSAULT SYSTEMES.png';
import fluidCodesLogo from '@/assets/images/partners/FLUIDCODES.png';
import gdbLogo from '@/assets/images/partners/GDB.png';
import matorLogo from '@/assets/images/partners/MATOR.png';
import mpLogo from '@/assets/images/partners/MP.png';
import aboutClubPhoto from '@/assets/images/about/about-the-club.webp';
import galleryEarth from '@/assets/images/gallery/earth.jpg';
import galleryExhibit from '@/assets/images/gallery/exhibit.jpg';
import galleryLaunch from '@/assets/images/gallery/launch.jpg';
import galleryOrbit from '@/assets/images/gallery/orbit.jpg';
import galleryVehicle from '@/assets/images/gallery/vehicle.jpg';
import galleryWorkshop from '@/assets/images/gallery/workshop.jpg';
import tuLogo from '@/assets/images/partners/TU.png';
import gateMetal from '@/assets/generated/gate-metal.webp';
import scaeLogo from '@/assets/generated/scae-logo.webp';
import contactDot from '@/assets/icons/contact-dot.svg?url';
import menuGrid from '@/assets/icons/menu-grid.svg?url';
import { ContactSection } from '@/components/sections/ContactSection';
import { GallerySection } from '@/components/sections/GallerySection';
import type { SocialLink } from '@/components/ui/ContactSocials';
import { LandingHero } from '@/components/ui/LandingHero';
import { getDictionary, localeStaticPaths, resolveLocale } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = localeStaticPaths;

const locale = resolveLocale(Astro.params.locale);
const t = getDictionary(locale);

// Anchors are placeholders until the sections they name exist.
const menuItems = [
  { id: 'about', label: t.menu.items.about, href: '#about' },
  { id: 'projects', label: t.menu.items.projects, href: '#projects' },
  { id: 'team', label: t.menu.items.team, href: '#team' },
  { id: 'events', label: t.menu.items.events, href: '#events' },
  { id: 'join', label: t.menu.items.join, href: '#join' },
  { id: 'contact', label: t.menu.items.contact, href: '#contact' },
];

const socialLinks: SocialLink[] = [
  {
    icon: 'linkedin',
    label: t.contact.socials.linkedin,
    href: 'https://www.linkedin.com/company/scaebulgaria/',
  },
  {
    icon: 'instagram',
    label: t.contact.socials.instagram,
    href: 'https://www.instagram.com/scae.bulgaria/',
  },
  {
    icon: 'email',
    label: t.contact.socials.email,
    href: 'mailto:contact@scae.bg',
  },
];
---

<BaseLayout locale={locale} title={t.site.name}>
  <LandingHero
    client:load
    metalSrc={gateMetal.src}
    logoSrc={scaeLogo.src}
    contactIconSrc={contactDot}
    menuIconSrc={menuGrid}
    label={t.home.heading}
    headline={t.home.headline}
    subtitle={t.home.subtitle}
    seeMore={t.home.seeMore}
    holdChallengeTitle={t.home.holdChallengeTitle}
    holdChallengeBody={t.home.holdChallengeBody}
    holdGoalTitle={t.home.holdGoalTitle}
    holdGoalBody={t.home.holdGoalBody}
    exhibitName={t.home.commodore}
    exhibitWork={t.home.ourWork}
    exhibitSection={t.home.sectionView}
    exhibitMission={t.home.missionConcept}
    exhibitGround={t.home.groundSegment}
    exhibitFxLabel={t.home.exhibitFx}
    aboutTitle={t.home.aboutClub}
    aboutBody={t.home.aboutClubBody}
    aboutPhotoSrc={aboutClubPhoto.src}
    aboutPhotoAlt={t.home.aboutClubPhotoAlt}
    aboutPhotoWidth={aboutClubPhoto.width}
    aboutPhotoHeight={aboutClubPhoto.height}
    partnersTitle={t.home.partners}
    partnersAria={t.home.partnersAria}
    partnerLogos={[
      {
        src: tuLogo.src,
        alt: t.home.partnerAlts.tu,
        width: tuLogo.width,
        height: tuLogo.height,
      },
      {
        src: ansysLogo.src,
        alt: t.home.partnerAlts.ansys,
        width: ansysLogo.width,
        height: ansysLogo.height,
      },
      {
        src: dassaultLogo.src,
        alt: t.home.partnerAlts.dassault,
        width: dassaultLogo.width,
        height: dassaultLogo.height,
      },
      {
        src: fluidCodesLogo.src,
        alt: t.home.partnerAlts.fluidCodes,
        width: fluidCodesLogo.width,
        height: fluidCodesLogo.height,
      },
      {
        src: matorLogo.src,
        alt: t.home.partnerAlts.mator,
        width: matorLogo.width,
        height: matorLogo.height,
      },
      {
        src: mpLogo.src,
        alt: t.home.partnerAlts.mp,
        width: mpLogo.width,
        height: mpLogo.height,
      },
      {
        src: gdbLogo.src,
        alt: t.home.partnerAlts.gdb,
        width: gdbLogo.width,
        height: gdbLogo.height,
      },
    ]}
    nav={{
      label: t.nav.label,
      brand: t.nav.brand,
      contact: t.nav.contact,
      menu: t.nav.menu,
    }}
    menu={{ label: t.menu.label, close: t.menu.close, items: menuItems }}
  />
  <div id="after-hero" class="void-ascent" aria-hidden="true"></div>
  <ContactSection
    client:visible
    copy={t.contact}
    locale={locale}
    logoSrc={scaeLogo.src}
    socialLinks={socialLinks}
  />
  <GallerySection
    client:visible={{ rootMargin: '1200px 0px' }}
    copy={t.gallery}
    logoSrc={scaeLogo.src}
    images={[
      {
        src: galleryWorkshop.src,
        alt: t.gallery.alts.workshop,
        width: galleryWorkshop.width,
        height: galleryWorkshop.height,
      },
      {
        src: galleryExhibit.src,
        alt: t.gallery.alts.exhibit,
        width: galleryExhibit.width,
        height: galleryExhibit.height,
      },
      {
        src: galleryLaunch.src,
        alt: t.gallery.alts.launch,
        width: galleryLaunch.width,
        height: galleryLaunch.height,
      },
      {
        src: galleryVehicle.src,
        alt: t.gallery.alts.vehicle,
        width: galleryVehicle.width,
        height: galleryVehicle.height,
      },
      {
        src: galleryOrbit.src,
        alt: t.gallery.alts.orbit,
        width: galleryOrbit.width,
        height: galleryOrbit.height,
      },
      {
        src: galleryEarth.src,
        alt: t.gallery.alts.earth,
        width: galleryEarth.width,
        height: galleryEarth.height,
      },
    ]}
  />
</BaseLayout>
