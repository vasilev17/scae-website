# Public site URL
PUBLIC_SITE_URL=http://localhost:4321

# Formspree form ids (https://formspree.io/forms) — the bare id, not the URL
PUBLIC_FORMSPREE_CONTACT_ID=
PUBLIC_FORMSPREE_APPLICATION_ID=

# hCaptcha site key (https://dashboard.hcaptcha.com/sites)
PUBLIC_HCAPTCHA_SITEKEY=

# PostHog EU — new project for this site, not the coming-soon one
# Project settings → Project token (write-only, starts with phc_)
PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
